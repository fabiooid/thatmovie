# LOCAL only — copy to ".env" on your laptop:
#   cp .env.example .env
# Do not commit .env.
#
# Cursor Cloud Agents: do NOT rely on this file. Set the same names as
# secrets in the Cloud Agents dashboard (https://cursor.com/dashboard/cloud-agents).
# The app reads process.env.TMDB_API_KEY (and the keys below).

# Chat agent (DeepSeek)
DEEPSEEK_API_KEY=

# Movie search embeddings (OpenAI)
OPENAI_API_KEY=

# Where-to-watch via TMDB Watch Providers (JustWatch-backed)
# Get a free "API Key (v3 auth)" at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
