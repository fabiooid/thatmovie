# Copy this file to ".env" in the same folder (project root), then fill in values:
#   cp .env.example .env
# Do not commit .env — it holds secrets.

# Chat agent (DeepSeek)
DEEPSEEK_API_KEY=

# Movie search embeddings (OpenAI)
OPENAI_API_KEY=

# Where-to-watch via TMDB Watch Providers (JustWatch-backed)
# Get a free "API Key (v3 auth)" at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
